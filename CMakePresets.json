{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "EXT_LIB_DIR": "${sourceDir}/ExtLibraries",
        "SETTINGS_DIR_FROM_EXE": "${sourceDir}/settings",
        "EXT_LIB_DIR_FROM_EXE": "${sourceDir}/ExtLibraries",
        "CORE_DIR_FROM_EXE": "${sourceDir}/s2e-core"
      }
    },
    {
      "name": "unix-debug",
      "hidden": true,
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_64BIT": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64 Debug",
      "description": "Build a 64-bit Debug executable on Linux.",
      "inherits": "unix-debug"
    },
    {
      "name": "linux-x86-debug",
      "displayName": "Linux x86 Debug",
      "description": "Build a 32-bit Debug executable on Linux.",
      "inherits": "unix-debug",
      "cacheVariables": {
        "BUILD_64BIT": "OFF"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS Apple Silicon Debug",
      "description": "Build a Debug executable for an Apple Silicon Mac.",
      "inherits": "unix-debug",
      "cacheVariables": {
        "APPLE_SILICON": "ON"
      }
    },
    {
      "name": "macos-x64-debug",
      "displayName": "macOS Intel Debug",
      "description": "Build a Debug executable for an Intel Mac.",
      "inherits": "unix-debug",
      "cacheVariables": {
        "APPLE_SILICON": "OFF"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "description": "Build a 64-bit Debug executable with Visual Studio 2022.",
      "inherits": "windows-base",
      "architecture": "x64",
      "cacheVariables": {
        "BUILD_64BIT": "ON"
      }
    },
    {
      "name": "windows-win32-debug",
      "displayName": "Windows Win32 Debug",
      "description": "Build a 32-bit Debug executable with Visual Studio 2022.",
      "inherits": "windows-base",
      "architecture": "Win32",
      "cacheVariables": {
        "BUILD_64BIT": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-x86-debug",
      "configurePreset": "linux-x86-debug"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64-debug"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-win32-debug",
      "configurePreset": "windows-win32-debug",
      "configuration": "Debug"
    }
  ]
}
